      <MemberType>Field</MemberType>
      <AssemblyInfo>
        <AssemblyName>Microsoft.EntityFrameworkCore.Cosmos</AssemblyName>
        <AssemblyVersion>11.0.0.0</AssemblyVersion>
      </AssemblyInfo>
      <ReturnValue>
        <ReturnType>Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode</ReturnType>
      </ReturnValue>
      <MemberValue>1</MemberValue>
      <Docs>
        <summary>
                Allows the usage of
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.UseSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String})" /> to overwrite the
                default Cosmos DB SDK automatic session token management.
                If 'UseSessionTokens' has not been invoked for a container, the default Cosmos DB SDK automatic session token management will be used.
                EF will track and parse session tokens returned from Cosmos DB, which can be retrieved via
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.GetSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade)" />.
            </summary>
      </Docs>
    </Member>

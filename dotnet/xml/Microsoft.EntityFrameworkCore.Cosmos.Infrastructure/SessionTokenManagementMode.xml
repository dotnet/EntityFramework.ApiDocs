        <AssemblyVersion>11.0.0.0</AssemblyVersion>
      </AssemblyInfo>
      <ReturnValue>
        <ReturnType>Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode</ReturnType>
      </ReturnValue>
      <MemberValue>0</MemberValue>
      <Docs>
        <summary>
                The default mode.
                Uses the underlying Cosmos DB SDK automatic session token management.
                EF will not track or parse session tokens returned from Cosmos DB.
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.UseSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String})" /> and
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.GetSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade)" /> methods will throw when invoked.
            </summary>
      </Docs>
    </Member>
    <Member MemberName="Manual">
      <MemberSignature Language="C#" Value="Manual" />
      <MemberSignature Language="ILAsm" Value=".field public static literal valuetype Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode Manual = int32(2)" />
      <MemberSignature Language="DocId" Value="F:Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode.Manual" />
      <MemberSignature Language="VB.NET" Value="Manual" />
      <MemberSignature Language="F#" Value="Manual = 2" Usage="Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode.Manual" />
      <MemberType>Field</MemberType>
      <AssemblyInfo>
        <AssemblyName>Microsoft.EntityFrameworkCore.Cosmos</AssemblyName>
        <AssemblyVersion>11.0.0.0</AssemblyVersion>
      </AssemblyInfo>
      <ReturnValue>
        <ReturnType>Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode</ReturnType>
      </ReturnValue>
      <MemberValue>2</MemberValue>
      <Docs>
        <summary>
                Fully overwrites the Cosmos DB SDK automatic session token management, and only uses session tokens specified via
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.UseSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String})" />.
                If 'UseSessionTokens' has not been invoked for a container, no session token will be used.
                EF will track and parse session tokens returned from Cosmos DB, which can be retrieved via
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.GetSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade)" />.
            </summary>
      </Docs>
    </Member>
    <Member MemberName="SemiAutomatic">
      <MemberSignature Language="C#" Value="SemiAutomatic" />

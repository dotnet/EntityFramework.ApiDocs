      <Docs>
        <summary>
                Same as <see cref="F:Microsoft.EntityFrameworkCore.Cosmos.Infrastructure.SessionTokenManagementMode.Manual" />, but will throw an exception if
                <see cref="M:Microsoft.EntityFrameworkCore.CosmosDatabaseFacadeExtensions.UseSessionTokens(Microsoft.EntityFrameworkCore.Infrastructure.DatabaseFacade,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String})" /> was not invoked
                before executing a read.
            </summary>
      </Docs>
    </Member>
    <Member MemberName="FullyAutomatic">
      <MemberSignature Language="C#" Value="FullyAutomatic" />
